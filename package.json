{
  "name": "@workout/root",
  "version": "0.0.0",
  "private": true,
  "description": "Single-user workout logger PWA with an agent-facing MCP server. Foundation milestone.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "^22.22.1 || ^24 || >=26",
    "pnpm": ">=11.5.2"
  },
  "scripts": {
    "dev": "pnpm --filter @workout/web dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --build --pretty",
    "test": "vitest run --project unit --project domain --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --project chromium-phone --grep-invert @a11y",
    "test:a11y": "playwright test --project chromium-phone --grep @a11y",
    "test:visual": "playwright test --grep @visual --update-snapshots=none",
    "visual:update": "playwright test --grep @visual --update-snapshots=changed",
    "test:architecture": "depcruise --config .dependency-cruiser.cjs apps packages",
    "test:licenses": "node node_modules/license-checker-rseidelsohn/bin/license-checker-rseidelsohn.js --production --excludePrivatePackages --onlyAllow '0BSD;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BlueOak-1.0.0;ISC;MIT;Python-2.0;Unlicense;Zlib' --excludePackages '@axe-core/playwright@4.13.0;@azu/style-format@1.0.1;axe-core@4.13.0;binaryextensions@6.11.0;caniuse-lite@1.0.30001810;editions@6.22.0;istextorbinary@9.5.0;lightningcss@1.33.0;lightningcss-android-arm64@1.33.0;lightningcss-darwin-arm64@1.33.0;lightningcss-darwin-x64@1.33.0;lightningcss-freebsd-x64@1.33.0;lightningcss-linux-arm-gnueabihf@1.33.0;lightningcss-linux-arm64-gnu@1.33.0;lightningcss-linux-arm64-musl@1.33.0;lightningcss-linux-x64-gnu@1.33.0;lightningcss-linux-x64-musl@1.33.0;lightningcss-win32-arm64-msvc@1.33.0;lightningcss-win32-x64-msvc@1.33.0;spdx-exceptions@2.5.0;spdx-license-ids@3.0.23;textextensions@6.11.0;version-range@4.15.0' --summary",
    "test:deps": "node scripts/audit-check.mjs",
    "test:secrets": "secretlint --secretlintrc .secretlintrc.json --maskSecrets \"**/*\" \"**/.*\" \"**/.*/**/*\" && node scripts/bundle-secrets.mjs",
    "test:migrations": "node scripts/validate-migrations.mjs",
    "test:guardrails": "node scripts/check-guardrails.mjs",
    "build": "pnpm typecheck && pnpm --filter \"./packages/**\" --filter \"./apps/**\" build",
    "storybook:build": "pnpm --filter @workout/web storybook:build",
    "verify": "node scripts/verify.mjs",
    "openspec": "openspec",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "prepare": "husky",
    "sbom:generate": "node scripts/sbom.mjs",
    "test:provider": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --project provider"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@fission-ai/openspec": "1.13.1",
    "@playwright/test": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "18.4.0",
    "husky": "9.1.7",
    "license-checker-rseidelsohn": "4.3.1",
    "lint-staged": "17.5.1",
    "secretlint": "13.0.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
