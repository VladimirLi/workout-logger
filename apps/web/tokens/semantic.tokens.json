        "$value": "{font-size.13}"
      },
      "body": {
        "$value": "{font-size.16}"
      },
      "title": {
        "$value": "{font-size.18}"
      },
      "heading": {
        "$value": "{font-size.22}"
      },
      "display-min": {
        "$value": "{font-size.40}"
      },
      "display-max": {
        "$value": "{font-size.64}"
      }
    },
    "line-height": {
      "$type": "number",
      "$description": "typography.def.line-height",
      "body": {
        "$value": "{number.1-5}"
      },
      "label": {
        "$value": "{number.1-3}"
      },
      "heading": {
        "$value": "{number.1-2}"
      },
      "display": {
        "$value": "{number.1-05}"
      }
    },
    "tracking": {
      "$type": "number",
      "$description": "typography.def.tracking, in em.",
      "body": {
        "$value": "{number.0}"
      },
      "heading": {
        "$value": "{number.-0-01}"
      },
      "display": {
        "$value": "{number.-0-03}"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "motion.def.tokens",
      "fast": {
        "$value": "{duration.100}"
      },
      "base": {
        "$value": "{duration.200}"
      },
      "slow": {
        "$value": "{duration.300}"
      },
      "skeleton-delay": {
        "$value": "{duration.300}",
        "$description": "feedback.loading.skeleton-delayed"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "motion.def.easing",
      "standard": {
        "$value": "{cubic-bezier.standard}"
      },
      "exit": {
        "$value": "{cubic-bezier.exit}"
      }
    }
  },
  "layer": {
    "$type": "number",
    "$description": "shape.def.layers: named order only. Components never use raw z-index numbers.",
    "base": {
      "$value": 0
    },
    "sticky": {
      "$value": 10
    },
    "sheet": {
      "$value": 20
    },
    "dialog": {
      "$value": 30
    },
    "toast": {
      "$value": 40
    }
  }
