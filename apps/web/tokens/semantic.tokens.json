  "font": {
    "family": {
      "$type": "fontFamily",
      "ui": {
        "$value": "{font-family.system}"
      },
      "mono": {
        "$value": "{font-family.mono}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "typography.def.weights",
      "body": {
        "$value": "{font-weight.400}"
      },
      "label": {
        "$value": "{font-weight.500}"
      },
      "heading": {
        "$value": "{font-weight.600}"
      },
      "display": {
        "$value": "{font-weight.700}"
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "typography.scale.two-tier: fixed UI tier in rem, fluid display tier.",
