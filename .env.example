# Example environment. NO REAL VALUES ARE EVER COMMITTED (SECURITY.md).
# Copy to .env.local and fill in once the external gates in docs/external-gates.md close.

# --- Supabase (gate G-2, not provisioned) --------------------------------------
# Browser-safe. Must be an https URL and an sb_publishable_… key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Must never reach the browser bundle, the service-worker cache,
# logs, or traces. The config validator refuses to build a browser config that
# carries this value. Must be an sb_secret_… key (not a legacy JWT).
SUPABASE_SECRET_KEY=

# --- Remote MCP (gates G-1, G-3, G-4, not provisioned) -------------------------
# The OAuth protected-resource identifier. Tokens are audience-validated against it.
MCP_RESOURCE_IDENTIFIER=
# Issuer used for authorization-server discovery.
MCP_AUTHORIZATION_SERVER=

# --- Web origin (gate G-3, not provisioned) ------------------------------------
# Production apex is gym.vladimirli.com. Changing the WebAuthn relying-party ID
# invalidates every enrolled passkey — decide before the first enrollment.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
WEBAUTHN_RELYING_PARTY_ID=localhost

# --- Telemetry (gate G-5, not provisioned) -------------------------------------
# Exporting is disabled when this is empty. The allowlist applies regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=workout-web
DEPLOYMENT_ENVIRONMENT=development
